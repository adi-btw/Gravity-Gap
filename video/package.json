{
  "name": "gravity-gap-video",
  "version": "1.0.0",
  "description": "Gravity Gap 30-second demo video (NASA Space Apps 2026), made with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/fonts": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "facts": "node scripts/build-facts.mjs",
    "render": "remotion render GravityGapDemo out/gravity-gap-demo.mp4",
    "stills": "remotion render GravityGapDemo out/stills --frames=40,120,250,395,445,525,600,640,690,745,860,884 --image-format=png && python scripts/sheet.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
